{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SmartReceiptDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET",
    "Issuer": "smart-receipt-api",
    "Audience": "smart-receipt-users",
    "ExpirationMinutes": 1440
  },
  "DocumentIntelligence": {
    "Endpoint": "",
    "ApiKey": "",
    "ModelId": "prebuilt-receipt"
  },
  "Uploads": {
    "MaxFileSizeBytes": 8388608,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
